{
  "name": "shutterhaus-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Shutterhaus Visuals \u2014 photography portfolio with a Google-auth admin gallery",
  "scripts": {
    "dev": "python tools/build-pages.py && vite",
    "build": "tsc --noEmit && python tools/build-pages.py && python tools/check-rows.py && python tools/check-srcset.py && vite build",
    "pages": "python tools/build-pages.py",
    "verify": "node tools/verify.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "probe:packer": "node tools/probe-packer.mjs",
    "test": "playwright test",
    "verify:controls": "playwright test tests/controls.spec.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
