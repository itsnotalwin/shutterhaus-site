# Copy this file to `.env` and fill in the two values from your Supabase project:
# Dashboard > Project Settings > API
#
# Both values are safe to commit — the anon key is public by design and the
# database is protected by Row Level Security (see supabase/schema.sql).
# NEVER put the service_role key in here; it bypasses RLS.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
